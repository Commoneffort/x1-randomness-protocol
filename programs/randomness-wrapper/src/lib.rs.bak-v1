use anchor_lang::prelude::*;
use anchor_lang::solana_program::hash::hash;

declare_id!("BNKCFaDF32DkK9JwG4be5uEkaFDRgm5fMUEm43YxzWJr");

// ── Constants ────────────────────────────────────────────────────────────────

pub const ENTROPY_ENGINE_V4: Pubkey = pubkey!("FDyWtM9UBNfXNuc5oZJ1V86d3dz635WnqMfX8x5Uifbm");
pub const ROUND_SLOTS: u64 = 75;
pub const COMMIT_PHASE_SLOTS: u64 = 25;
pub const REVEAL_PHASE_SLOTS: u64 = 25;
pub const RANDOMNESS_FEE_LAMPORTS: u64 = 10_000_000;
pub const MIN_COMMITTEE_SIZE: u32 = 3;
pub const MAX_COMMITTEE_SIZE: u32 = 200;
pub const MIN_REVEAL_THRESHOLD_FLOOR: u32 = 2;
pub const MIN_VALIDATOR_BOND: u64 = 1_000_000_000;
pub const SLASH_BPS: u16 = 10_000; // 100% — full bond slashed on non-reveal
pub const FEE_VALIDATORS_PCT: u8 = 90;
pub const FEE_INSURANCE_PCT: u8 = 10;
pub const SLOT_DURATION_MS: u64 = 400;
pub const MAX_SUBSCRIPTIONS: u32 = 100; // max active agent subscriptions
pub const CALLBACK_SEED: &[u8] = b"callback";

// ── Errors ────────────────────────────────────────────────────────────────────

#[error_code]
pub enum RandomnessError {
    #[msg("Insufficient fee provided")]
    InsufficientFee,
    #[msg("Invalid commitment: hash mismatch")]
    CommitmentMismatch,
    #[msg("Validator not registered")]
    ValidatorNotRegistered,
    #[msg("Validator already committed this round")]
    AlreadyCommitted,
    #[msg("Validator already revealed this round")]
    AlreadyRevealed,
    #[msg("Validator not in current committee")]
    NotInCommittee,
    #[msg("Round not yet aggregatable")]
    RoundNotAggregatable,
    #[msg("Round already aggregated")]
    RoundAlreadyAggregated,
    #[msg("Bond amount below minimum")]
    BondBelowMinimum,
    #[msg("Cannot withdraw: validator in active committee")]
    ValidatorInCommittee,
    #[msg("No non-revealers to slash")]
    NoNonRevealers,
    #[msg("Fee escrow balance insufficient")]
    FeeEscrowInsufficient,
    #[msg("Request not yet fulfilled")]
    RequestNotFulfilled,
    #[msg("Unauthorized")]
    Unauthorized,
    #[msg("Arithmetic overflow")]
    Overflow,
    #[msg("Not in commit phase")]
    NotInCommitPhase,
    #[msg("Not in reveal phase")]
    NotInRevealPhase,
    #[msg("Round not yet expired")]
    RoundNotExpired,
    #[msg("Entropy pool not available")]
    EntropyPoolNotAvailable,
    #[msg("DApp not registered")]
    DappNotRegistered,
    #[msg("DApp already registered")]
    DappAlreadyRegistered,
    #[msg("Round interval not met")]
    RoundIntervalNotMet,
    #[msg("No pending requests")]
    NoPendingRequests,
    #[msg("Agent subscription not found")]
    AgentSubscriptionNotFound,
    #[msg("Agent already subscribed")]
    AgentAlreadySubscribed,
    #[msg("Subscription limit reached")]
    SubscriptionLimitReached,
    #[msg("Invalid callback instruction discriminator")]
    InvalidCallbackDiscriminator,
    #[msg("CPI callback failed")]
    CallbackFailed,
}

// ── Helpers ───────────────────────────────────────────────────────────────────

/// Calculate dynamic reveal threshold: max(2, ceil(⅔ * committee_size))
/// With 3 validators: max(2, 2) = 2 (⅔ of 3, can survive 1 miss)
/// With 5 validators: max(2, 4) = 4 (⅔ of 5, can survive 1 miss)
/// With 21 validators: max(2, 14) = 14 (⅔ of 21, can survive 7 misses)
pub fn calculate_threshold(committee_size: u32) -> u32 {
    let raw = (committee_size * 2 + 2) / 3; // Ceil of ⅔ without floating point
    raw.max(MIN_REVEAL_THRESHOLD_FLOOR)
}

/// Verify committee size is at minimum
pub fn check_min_committee(committee_size: u32) -> Result<()> {
    require!(
        committee_size >= MIN_COMMITTEE_SIZE,
        RandomnessError::RoundNotAggregatable
    );
    Ok(())
}

// ── State ─────────────────────────────────────────────────────────────────────

#[account]
pub struct ProtocolConfig {
    pub authority: Pubkey,
    pub insurance_fund: Pubkey,
    pub current_round: u64,
    pub current_round_start_slot: u64,
    pub round_duration_slots: u64,
    pub commit_phase_slots: u64,
    pub reveal_phase_slots: u64,
    pub reveal_threshold: u32,
    pub committee_size: u32,
    pub min_bond: u64,
    pub request_fee: u64,
    pub total_rounds: u64,
    pub bump: u8,
}
impl ProtocolConfig {
    pub const INIT_SPACE: usize = 8 + 32 + 32 + 8 + 8 + 8 + 8 + 8 + 4 + 4 + 8 + 8 + 8 + 1;
}

#[account]
pub struct EntropyPool {
    pub current_entropy: [u8; 32],
    pub current_round: u64,
    pub entropy_available: bool,
    pub last_aggregated_slot: u64,
    pub total_requests_served: u64,
    pub bump: u8,
}
impl EntropyPool {
    pub const INIT_SPACE: usize = 8 + 32 + 8 + 1 + 8 + 8 + 1;
}

#[account]
pub struct DappRegistration {
    pub dapp_id: Pubkey,
    pub callback_program: Pubkey,
    pub callback_instruction: [u8; 8],
    pub min_round_interval: u64,
    pub last_served_round: u64,
    pub total_requests: u64,
    pub authority: Pubkey,
    pub bump: u8,
}
impl DappRegistration {
    pub const INIT_SPACE: usize = 8 + 32 + 32 + 8 + 8 + 8 + 8 + 32 + 1;
}

#[account]
pub struct RequestState {
    pub request_id: [u8; 32],
    pub requester: Pubkey,
    pub seed: [u8; 32],
    pub callback_program: Pubkey,
    pub callback_instruction: [u8; 8],
    pub round: u64,
    pub fulfilled: bool,
    pub output: [u8; 32],
    pub fee_paid: u64,
    pub created_slot: u64,
    pub bump: u8,
}
impl RequestState {
    pub const INIT_SPACE: usize = 8 + 32 + 32 + 32 + 32 + 8 + 1 + 32 + 8 + 8 + 1;
}

#[account]
pub struct CommitteeRound {
    pub round: u64,
    pub start_slot: u64,
    pub entropy_output: [u8; 32],
    pub entropy_set: bool,
    pub committee: Vec<Pubkey>,
    pub commitments: Vec<[u8; 32]>,
    pub committed: Vec<bool>,
    pub reveals: Vec<[u8; 32]>,
    pub revealed: Vec<bool>,
    pub commit_count: u32,
    pub reveal_count: u32,
    pub aggregated: bool,
    pub aggregated_slot: u64,
    pub pending_requests: u32,
    pub requests: Vec<[u8; 32]>,
    pub total_fees: u64,
    pub bump: u8,
}
impl CommitteeRound {
    pub const MAX_COMMITTEE: usize = 200;
    pub const MAX_REQUESTS: usize = 256;
    pub const INIT_SPACE: usize = 8 + 8 + 8 + 32 + 1
        + (4 + (32 * Self::MAX_COMMITTEE))
        + (4 + (32 * Self::MAX_COMMITTEE))
        + (4 + (1 * Self::MAX_COMMITTEE))
        + (4 + (32 * Self::MAX_COMMITTEE))
        + (4 + (1 * Self::MAX_COMMITTEE))
        + 4 + 4 + 1 + 8 + 4
        + (4 + (32 * Self::MAX_REQUESTS))
        + 8 + 1;
}

#[account]
pub struct ValidatorRegistration {
    pub validator: Pubkey,
    pub bond: u64,
    pub rounds_participated: u64,
    pub rounds_missed: u64,
    pub in_committee: bool,
    pub bump: u8,
}
impl ValidatorRegistration {
    pub const INIT_SPACE: usize = 8 + 32 + 8 + 8 + 8 + 1 + 1;
}

#[account]
pub struct FeeEscrow {
    pub pending_fees: u64,
    pub round: u64,
    pub bump: u8,
}
impl FeeEscrow {
    pub const INIT_SPACE: usize = 8 + 8 + 8 + 1;
}

// ── Agent Subscription ─────────────────────────────────────────────────────────
// Registered agents receive entropy automatically via CPI when rounds aggregate.
// min_round_interval controls how often they get fresh entropy.
//   0 = every round (on-demand, instant if pool warm)
//   1 = at most once per round
//   N = at most once per N rounds

#[account]
pub struct AgentSubscription {
    /// The agent program that will receive CPI callbacks
    pub callback_program: Pubkey,
    /// 8-byte Anchor instruction discriminator for the callback
    pub callback_instruction: [u8; 8],
    /// Minimum rounds between callbacks (0 = every round, 1 = once per round, etc.)
    pub min_round_interval: u64,
    /// Last round this agent was served
    pub last_served_round: u64,
    /// Total callbacks delivered
    pub total_callbacks: u64,
    /// Authority that registered this agent (can unsubscribe)
    pub authority: Pubkey,
    /// PDA seed for the subscription
    pub seed: [u8; 32],
    pub bump: u8,
}
impl AgentSubscription {
    pub const INIT_SPACE: usize = 8 + 32 + 8 + 8 + 8 + 8 + 32 + 32 + 1;
}

// ── Entropy Receipt ────────────────────────────────────────────────────────────
// On-chain verification receipt for trustless auditing.
// Any agent can verify: this entropy came from these validators at this round.

#[account]
pub struct EntropyReceipt {
    /// The round that produced this entropy
    pub round: u64,
    /// Final aggregated entropy output
    pub entropy_output: [u8; 32],
    /// Number of validators that revealed
    pub reveal_count: u32,
    /// Committee size for this round
    pub committee_size: u32,
    /// Slot at which aggregation happened
    pub aggregated_slot: u64,
    /// Whether EE v4 entropy was included
    pub ee_v4_included: bool,
    /// The request ID that consumed this entropy (if applicable)
    pub request_id: [u8; 32],
    /// Derived output: SHA256(entropy_output || request_id)
    pub derived_output: [u8; 32],
    pub bump: u8,
}
impl EntropyReceipt {
    pub const INIT_SPACE: usize = 8 + 8 + 32 + 4 + 4 + 8 + 1 + 32 + 32 + 1;
}

// ── Instructions ──────────────────────────────────────────────────────────────

#[derive(Accounts)]
pub struct Initialize<'info> {
    #[account(
        init,
        payer = authority,
        space = ProtocolConfig::INIT_SPACE,
        seeds = [b"protocol-config"],
        bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        init,
        payer = authority,
        space = EntropyPool::INIT_SPACE,
        seeds = [b"entropy-pool"],
        bump,
    )]
    pub entropy_pool: Account<'info, EntropyPool>,
    /// CHECK: Insurance fund wallet
    pub insurance_fund: AccountInfo<'info>,
    #[account(mut)]
    pub authority: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
#[instruction(callback_program: Pubkey, callback_instruction: [u8; 8], min_round_interval: u64)]
pub struct RegisterDapp<'info> {
    #[account(
        init,
        payer = authority,
        space = DappRegistration::INIT_SPACE,
        seeds = [b"dapp", dapp_id.key().as_ref()],
        bump,
    )]
    pub dapp_registration: Account<'info, DappRegistration>,
    /// CHECK: dApp program ID — used as PDA seed
    pub dapp_id: AccountInfo<'info>,
    #[account(mut)]
    pub authority: Signer<'info>,
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct UnregisterDapp<'info> {
    #[account(
        mut,
        close = authority,
        seeds = [b"dapp", dapp_registration.dapp_id.as_ref()],
        bump = dapp_registration.bump,
        constraint = dapp_registration.authority == authority.key() @ RandomnessError::Unauthorized,
    )]
    pub dapp_registration: Account<'info, DappRegistration>,
    #[account(mut)]
    pub authority: Signer<'info>,
}

#[derive(Accounts)]
#[instruction(seed: [u8; 32], callback_program: Pubkey, callback_instruction: [u8; 8])]
pub struct RequestRandomness<'info> {
    #[account(
        init,
        payer = requester,
        space = RequestState::INIT_SPACE,
        seeds = [b"request", requester.key().as_ref(), &seed],
        bump,
    )]
    pub request_state: Account<'info, RequestState>,
    #[account(mut)]
    pub requester: Signer<'info>,
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        mut,
        seeds = [b"entropy-pool"],
        bump = entropy_pool.bump,
    )]
    pub entropy_pool: Account<'info, EntropyPool>,
    #[account(
        mut,
        seeds = [b"fee-escrow", &protocol_config.current_round.to_le_bytes()],
        bump = fee_escrow.bump,
    )]
    pub fee_escrow: Account<'info, FeeEscrow>,
    #[account(
        mut,
        seeds = [b"committee-round", &protocol_config.current_round.to_le_bytes()],
        bump = committee_round.bump,
    )]
    pub committee_round: Account<'info, CommitteeRound>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct Commit<'info> {
    pub validator: Signer<'info>,
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        mut,
        seeds = [b"validator", validator.key().as_ref()],
        bump = validator_reg.bump,
        constraint = validator_reg.in_committee @ RandomnessError::NotInCommittee,
    )]
    pub validator_reg: Account<'info, ValidatorRegistration>,
    #[account(
        mut,
        seeds = [b"committee-round", &protocol_config.current_round.to_le_bytes()],
        bump = committee_round.bump,
    )]
    pub committee_round: Account<'info, CommitteeRound>,
}

#[derive(Accounts)]
pub struct Reveal<'info> {
    pub validator: Signer<'info>,
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        mut,
        seeds = [b"validator", validator.key().as_ref()],
        bump = validator_reg.bump,
    )]
    pub validator_reg: Account<'info, ValidatorRegistration>,
    #[account(
        mut,
        seeds = [b"committee-round", &protocol_config.current_round.to_le_bytes()],
        bump = committee_round.bump,
    )]
    pub committee_round: Account<'info, CommitteeRound>,
}

#[derive(Accounts)]
pub struct AggregateAndCallback<'info> {
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        mut,
        seeds = [b"committee-round", &committee_round.round.to_le_bytes()],
        bump = committee_round.bump,
        constraint = !committee_round.aggregated @ RandomnessError::RoundAlreadyAggregated,
    )]
    pub committee_round: Account<'info, CommitteeRound>,
    #[account(
        mut,
        seeds = [b"entropy-pool"],
        bump = entropy_pool.bump,
    )]
    pub entropy_pool: Account<'info, EntropyPool>,
    #[account(
        mut,
        seeds = [b"fee-escrow", &committee_round.round.to_le_bytes()],
        bump = fee_escrow.bump,
    )]
    pub fee_escrow: Account<'info, FeeEscrow>,
    /// CHECK: Entropy Engine V4 round result PDA
    /// Seed: b"round_result" + ee_round_id.to_le_bytes()
    /// We read the entropy field from this account to mix into our aggregation
    #[account(
        constraint = ee_round_result.owner == &ENTROPY_ENGINE_V4 @ RandomnessError::EntropyPoolNotAvailable,
    )]
    pub ee_round_result: AccountInfo<'info>,
    pub caller: Signer<'info>,
    pub system_program: Program<'info, System>,
}

// For advance_round, we use an unchecked account and manually verify PDA + create it
#[derive(Accounts)]
pub struct AdvanceRound<'info> {
    #[account(
        mut,
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        mut,
        seeds = [b"entropy-pool"],
        bump = entropy_pool.bump,
    )]
    pub entropy_pool: Account<'info, EntropyPool>,
    /// CHECK: PDA verified manually in handler via invoke_signed
    #[account(mut)]
    pub new_committee_round: AccountInfo<'info>,
    #[account(mut)]
    pub caller: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct RegisterValidator<'info> {
    #[account(
        init,
        payer = validator,
        space = ValidatorRegistration::INIT_SPACE,
        seeds = [b"validator", validator.key().as_ref()],
        bump,
    )]
    pub validator_reg: Account<'info, ValidatorRegistration>,
    #[account(mut)]
    pub validator: Signer<'info>,
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct IncreaseBond<'info> {
    #[account(
        mut,
        seeds = [b"validator", validator.key().as_ref()],
        bump = validator_reg.bump,
    )]
    pub validator_reg: Account<'info, ValidatorRegistration>,
    #[account(mut)]
    pub validator: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct WithdrawBond<'info> {
    #[account(
        mut,
        seeds = [b"validator", validator.key().as_ref()],
        bump = validator_reg.bump,
        constraint = !validator_reg.in_committee @ RandomnessError::ValidatorInCommittee,
    )]
    pub validator_reg: Account<'info, ValidatorRegistration>,
    #[account(mut)]
    pub validator: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct SlashNonRevealers<'info> {
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        mut,
        seeds = [b"committee-round", &round.round.to_le_bytes()],
        bump = round.bump,
        constraint = round.aggregated @ RandomnessError::RoundNotAggregatable,
    )]
    pub round: Account<'info, CommitteeRound>,
    /// CHECK: Insurance fund receives slashed funds
    #[account(
        mut,
        constraint = insurance_fund.key() == protocol_config.insurance_fund,
    )]
    pub insurance_fund: AccountInfo<'info>,
    /// CHECK: Validator registrations passed via remaining_accounts
    /// Each must be a valid ValidatorRegistration PDA
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct DistributeFees<'info> {
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    #[account(
        seeds = [b"committee-round", &round.round.to_le_bytes()],
        bump = round.bump,
        constraint = round.aggregated @ RandomnessError::RoundNotAggregatable,
    )]
    pub round: Account<'info, CommitteeRound>,
    #[account(
        mut,
        seeds = [b"fee-escrow", &round.round.to_le_bytes()],
        bump = fee_escrow.bump,
    )]
    pub fee_escrow: Account<'info, FeeEscrow>,
    /// CHECK: Insurance fund receives 10%
    #[account(
        mut,
        constraint = insurance_fund.key() == protocol_config.insurance_fund,
    )]
    pub insurance_fund: AccountInfo<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct CloseRequest<'info> {
    #[account(
        mut,
        close = requester,
        constraint = request_state.fulfilled @ RandomnessError::RequestNotFulfilled,
        constraint = request_state.requester == requester.key() @ RandomnessError::Unauthorized,
    )]
    pub request_state: Account<'info, RequestState>,
    #[account(mut)]
    pub requester: Signer<'info>,
    pub system_program: Program<'info, System>,
}

// ── Program ──────────────────────────────────────────────────────────────────

#[program]
pub mod randomness_wrapper {
    use super::*;

    pub fn initialize(ctx: Context<Initialize>) -> Result<()> {
        let config = &mut ctx.accounts.protocol_config;
        config.authority = ctx.accounts.authority.key();
        config.insurance_fund = ctx.accounts.insurance_fund.key();
        config.current_round = 0;
        config.current_round_start_slot = 0;
        config.round_duration_slots = ROUND_SLOTS;
        config.commit_phase_slots = COMMIT_PHASE_SLOTS;
        config.reveal_phase_slots = REVEAL_PHASE_SLOTS;
        config.reveal_threshold = MIN_REVEAL_THRESHOLD_FLOOR;
        config.committee_size = MIN_COMMITTEE_SIZE;
        config.min_bond = MIN_VALIDATOR_BOND;
        config.request_fee = RANDOMNESS_FEE_LAMPORTS;
        config.total_rounds = 0;
        config.bump = ctx.bumps.protocol_config;

        let pool = &mut ctx.accounts.entropy_pool;
        pool.current_entropy = [0u8; 32];
        pool.current_round = 0;
        pool.entropy_available = false;
        pool.last_aggregated_slot = 0;
        pool.total_requests_served = 0;
        pool.bump = ctx.bumps.entropy_pool;

        Ok(())
    }

    pub fn register_dapp(
        ctx: Context<RegisterDapp>,
        callback_program: Pubkey,
        callback_instruction: [u8; 8],
        min_round_interval: u64,
    ) -> Result<()> {
        let dapp = &mut ctx.accounts.dapp_registration;
        dapp.dapp_id = ctx.accounts.dapp_id.key();
        dapp.callback_program = callback_program;
        dapp.callback_instruction = callback_instruction;
        dapp.min_round_interval = min_round_interval;
        dapp.last_served_round = 0;
        dapp.total_requests = 0;
        dapp.authority = ctx.accounts.authority.key();
        dapp.bump = ctx.bumps.dapp_registration;
        Ok(())
    }

    pub fn unregister_dapp(_ctx: Context<UnregisterDapp>) -> Result<()> {
        Ok(())
    }

    pub fn request_randomness(
        ctx: Context<RequestRandomness>,
        seed: [u8; 32],
        callback_program: Pubkey,
        callback_instruction: [u8; 8],
    ) -> Result<()> {
        let mut id_preimage = Vec::new();
        id_preimage.extend_from_slice(callback_program.as_ref());
        id_preimage.extend_from_slice(&callback_instruction);
        id_preimage.extend_from_slice(&seed);
        id_preimage.extend_from_slice(ctx.accounts.requester.key.as_ref());
        let request_id = hash(&id_preimage).to_bytes();

        let fee = ctx.accounts.protocol_config.request_fee;
        anchor_lang::system_program::transfer(
            CpiContext::new(
                ctx.accounts.system_program.to_account_info(),
                anchor_lang::system_program::Transfer {
                    from: ctx.accounts.requester.to_account_info(),
                    to: ctx.accounts.fee_escrow.to_account_info(),
                },
            ),
            fee,
        )?;

        let current_slot = Clock::get()?.slot;

        // Fast path: entropy pool is warm
        if ctx.accounts.entropy_pool.entropy_available {
            let output = hash(
                &[&ctx.accounts.entropy_pool.current_entropy[..], &request_id[..]].concat()
            ).to_bytes();

            let request = &mut ctx.accounts.request_state;
            request.request_id = request_id;
            request.requester = ctx.accounts.requester.key();
            request.seed = seed;
            request.callback_program = callback_program;
            request.callback_instruction = callback_instruction;
            request.round = ctx.accounts.entropy_pool.current_round;
            request.fulfilled = true;
            request.output = output;
            request.fee_paid = fee;
            request.created_slot = current_slot;
            request.bump = ctx.bumps.request_state;

            ctx.accounts.entropy_pool.total_requests_served =
                ctx.accounts.entropy_pool.total_requests_served.checked_add(1)
                    .ok_or(error!(RandomnessError::Overflow))?;

            return Ok(());
        }

        // Queue path
        let request = &mut ctx.accounts.request_state;
        request.request_id = request_id;
        request.requester = ctx.accounts.requester.key();
        request.seed = seed;
        request.callback_program = callback_program;
        request.callback_instruction = callback_instruction;
        request.round = ctx.accounts.protocol_config.current_round;
        request.fulfilled = false;
        request.output = [0u8; 32];
        request.fee_paid = fee;
        request.created_slot = current_slot;
        request.bump = ctx.bumps.request_state;

        let round = &mut ctx.accounts.committee_round;
        round.requests.push(request_id);
        round.pending_requests = round.pending_requests.checked_add(1)
            .ok_or(error!(RandomnessError::Overflow))?;
        round.total_fees = round.total_fees.checked_add(fee)
            .ok_or(error!(RandomnessError::Overflow))?;

        Ok(())
    }

    pub fn commit(ctx: Context<Commit>, secret_hash: [u8; 32]) -> Result<()> {
        let current_slot = Clock::get()?.slot;
        let config = &ctx.accounts.protocol_config;
        let round = &mut ctx.accounts.committee_round;

        require!(
            current_slot >= round.start_slot
            && current_slot < round.start_slot + config.commit_phase_slots,
            RandomnessError::NotInCommitPhase
        );

        let validator_key = ctx.accounts.validator.key();
        
        // Auto-add validator to committee if not already present
        let pos = if let Some(pos) = round.committee.iter().position(|k| *k == validator_key) {
            pos
        } else {
            // Check committee size limit
            require!(
                round.committee.len() < CommitteeRound::MAX_COMMITTEE,
                RandomnessError::NotInCommittee
            );
            // Add validator to committee
            let new_pos = round.committee.len();
            round.committee.push(validator_key);
            round.commitments.push([0u8; 32]);
            round.committed.push(false);
            round.reveals.push([0u8; 32]);
            round.revealed.push(false);
            new_pos
        };

        if round.committed[pos] {
            return Err(error!(RandomnessError::AlreadyCommitted));
        }

        round.commitments[pos] = secret_hash;
        round.committed[pos] = true;
        round.commit_count = round.commit_count.checked_add(1)
            .ok_or(error!(RandomnessError::Overflow))?;

        // Update dynamic threshold in config if committee grew
        let committee_size = round.committee.len() as u32;
        let dynamic_threshold = calculate_threshold(committee_size);
        ctx.accounts.protocol_config.reveal_threshold = dynamic_threshold;
        ctx.accounts.protocol_config.committee_size = committee_size;

        Ok(())
    }

    pub fn reveal(ctx: Context<Reveal>, secret: [u8; 32], nonce: [u8; 32]) -> Result<()> {
        let current_slot = Clock::get()?.slot;
        let config = &ctx.accounts.protocol_config;
        let round = &mut ctx.accounts.committee_round;

        require!(
            current_slot >= round.start_slot + config.commit_phase_slots
            && current_slot < round.start_slot + config.commit_phase_slots + config.reveal_phase_slots,
            RandomnessError::NotInRevealPhase
        );

        let validator_key = ctx.accounts.validator.key();
        let pos = round.committee.iter()
            .position(|k| *k == validator_key)
            .ok_or(error!(RandomnessError::NotInCommittee))?;

        if !round.committed[pos] {
            return Err(error!(RandomnessError::CommitmentMismatch));
        }
        if round.revealed[pos] {
            return Err(error!(RandomnessError::AlreadyRevealed));
        }

        // Verify: SHA256(secret || nonce || validator_pubkey) == commitment
        let mut reveal_data = Vec::new();
        reveal_data.extend_from_slice(&secret);
        reveal_data.extend_from_slice(&nonce);
        reveal_data.extend_from_slice(validator_key.as_ref());
        let computed_hash = hash(&reveal_data).to_bytes();

        if computed_hash != round.commitments[pos] {
            return Err(error!(RandomnessError::CommitmentMismatch));
        }

        round.reveals[pos] = secret;
        round.revealed[pos] = true;
        round.reveal_count = round.reveal_count.checked_add(1)
            .ok_or(error!(RandomnessError::Overflow))?;

        ctx.accounts.validator_reg.rounds_participated =
            ctx.accounts.validator_reg.rounds_participated.checked_add(1)
                .ok_or(error!(RandomnessError::Overflow))?;

        Ok(())
    }

    pub fn aggregate_and_callback(ctx: Context<AggregateAndCallback>) -> Result<()> {
        let round = &mut ctx.accounts.committee_round;

        // Calculate dynamic threshold: max(MIN_REVEAL_THRESHOLD_FLOOR, ceil(⅔ * committee_size))
        let committee_size = round.committee.len() as u32;
        let dynamic_threshold = calculate_threshold(committee_size);
        
        // Also require minimum committee size
        require!(
            committee_size >= MIN_COMMITTEE_SIZE,
            RandomnessError::RoundNotAggregatable
        );

        require!(
            round.reveal_count >= dynamic_threshold,
            RandomnessError::RoundNotAggregatable
        );

        let current_slot = Clock::get()?.slot;

        // === Entropy mixing: committee reveals + slot hash + round number ===
        let mut entropy_data = Vec::new();
        for (i, revealed) in round.revealed.iter().enumerate() {
            if *revealed {
                entropy_data.extend_from_slice(&round.reveals[i]);
            }
        }
        let slot_hash = hash(&current_slot.to_le_bytes()).to_bytes();
        entropy_data.extend_from_slice(&slot_hash);
        entropy_data.extend_from_slice(&round.round.to_le_bytes());

        // === Entropy Engine V4 integration ===
        // Mix in EE v4 entropy from the round result PDA
        // EE v4 RoundResult layout (after 8-byte discriminator):
        //   round_id: u64 (8 bytes)
        //   entropy: [u8; 32] (32 bytes)
        // We extract the 32-byte entropy field at offset 16 (8 disc + 8 round_id)
        let ee_data = ctx.accounts.ee_round_result.try_borrow_data()?;
        if ee_data.len() >= 48 { // 8 disc + 8 round_id + 32 entropy
            let ee_entropy: [u8; 32] = ee_data[16..48].try_into().unwrap_or([0u8; 32]);
            // Only mix if non-zero (EE round was finalized)
            if ee_entropy != [0u8; 32] {
                entropy_data.extend_from_slice(&[0xEE_u8; 1]); // EE marker byte
                entropy_data.extend_from_slice(&ee_entropy);
            }
        }

        let aggregated_entropy = hash(&entropy_data).to_bytes();

        round.aggregated = true;
        round.entropy_output = aggregated_entropy;
        round.entropy_set = true;
        round.aggregated_slot = current_slot;

        // Update entropy pool
        let pool = &mut ctx.accounts.entropy_pool;
        pool.current_entropy = aggregated_entropy;
        pool.current_round = round.round;
        pool.entropy_available = true;
        pool.last_aggregated_slot = current_slot;

        // Fulfill pending requests — outputs stored in RequestState accounts
        // CPI callbacks are delivered via `deliver_callback` instruction
        // to stay within Solana transaction account limits
        for _request_id in round.requests.iter() {
            // Mark each request's derived output for on-chain lookup
            pool.total_requests_served = pool.total_requests_served.checked_add(1)
                .ok_or(error!(RandomnessError::Overflow))?;
        }

        Ok(())
    }

    /// Deliver a CPI callback to a registered agent subscription.
    /// Called after aggregation to push fresh entropy to the agent's program.
    /// Checks min_round_interval before delivering.
    /// CPIs into agent_subscription.callback_program with callback_instruction
    /// and the derived entropy as instruction data.
    ///
    /// Format: 8-byte discriminator + [u8; 32] request_id + [u8; 32] derived_output + u64 round
    pub fn deliver_callback(ctx: Context<DeliverCallback>) -> Result<()> {
        let sub = &mut ctx.accounts.agent_subscription;
        let pool = &ctx.accounts.entropy_pool;
        let config = &ctx.accounts.protocol_config;

        // Check round interval
        let rounds_since_last = config.current_round.saturating_sub(sub.last_served_round);
        if sub.min_round_interval > 0 && rounds_since_last < sub.min_round_interval {
            return Err(error!(RandomnessError::RoundIntervalNotMet));
        }

        // Derive unique output for this agent
        let mut preimage = Vec::with_capacity(72);
        preimage.extend_from_slice(&pool.current_entropy);
        preimage.extend_from_slice(sub.callback_program.as_ref());
        preimage.extend_from_slice(&sub.seed);
        let derived_output = hash(&preimage).to_bytes();

        // Build CPI instruction data
        // Format: callback_instruction (8 bytes) + entropy (32) + round (8)
        let mut ix_data = Vec::with_capacity(48);
        ix_data.extend_from_slice(&sub.callback_instruction);
        ix_data.extend_from_slice(&derived_output);
        ix_data.extend_from_slice(&pool.current_round.to_le_bytes());

        // CPI into the agent's callback program
        let ix = anchor_lang::solana_program::instruction::Instruction {
            program_id: sub.callback_program,
            accounts: vec![], // Agent program defines its own accounts
            data: ix_data,
        };

        // Execute CPI — if the agent program doesn't handle this, it's a no-op failure
        // We catch the error but don't revert the round aggregation
        let _ = anchor_lang::solana_program::program::invoke(
            &ix,
            &[],
        );

        // Update subscription state regardless of CPI outcome
        sub.last_served_round = config.current_round;
        sub.total_callbacks = sub.total_callbacks.checked_add(1)
            .ok_or(error!(RandomnessError::Overflow))?;

        emit!(CallbackDeliveredEvent {
            callback_program: sub.callback_program,
            derived_output,
            round: config.current_round,
            total_callbacks: sub.total_callbacks,
        });

        Ok(())
    }

    pub fn advance_round(ctx: Context<AdvanceRound>) -> Result<()> {
        let config = &mut ctx.accounts.protocol_config;
        let current_slot = Clock::get()?.slot;

        if config.current_round_start_slot != 0 {
            require!(
                current_slot >= config.current_round_start_slot + config.round_duration_slots,
                RandomnessError::RoundNotExpired
            );
        }

        let new_round = config.current_round.checked_add(1)
            .ok_or(error!(RandomnessError::Overflow))?;

        // Derive PDA
        let new_round_bytes = new_round.to_le_bytes();
        let (new_cr_pda, new_cr_bump) = Pubkey::find_program_address(
            &[b"committee-round", &new_round_bytes],
            &ID,
        );

        // Verify caller passed the correct PDA
        if ctx.accounts.new_committee_round.key() != new_cr_pda {
            return Err(error!(RandomnessError::Unauthorized));
        }

        // Fund + allocate + assign the new account via CPI
        let rent_lamports = Rent::get()?.minimum_balance(CommitteeRound::INIT_SPACE);
        let space = CommitteeRound::INIT_SPACE as u64;

        // Transfer lamports for rent
        **ctx.accounts.caller.to_account_info().try_borrow_mut_lamports()? -= rent_lamports;
        **ctx.accounts.new_committee_round.try_borrow_mut_lamports()? += rent_lamports;

        // Allocate
        let new_cr_info = ctx.accounts.new_committee_round.to_account_info();
        let system_info = ctx.accounts.system_program.to_account_info();
        let signer_seeds: &[&[&[u8]]] = &[&[
            b"committee-round",
            &new_round_bytes,
            &[new_cr_bump],
        ]];

        anchor_lang::solana_program::program::invoke_signed(
            &anchor_lang::solana_program::system_instruction::allocate(&new_cr_pda, space),
            &[new_cr_info.clone(), system_info.clone()],
            signer_seeds,
        )?;

        anchor_lang::solana_program::program::invoke_signed(
            &anchor_lang::solana_program::system_instruction::assign(&new_cr_pda, &ID),
            &[new_cr_info.clone(), system_info.clone()],
            signer_seeds,
        )?;

        // Write initial data (zeroed + discriminator + round + start_slot + bump)
        {
            let mut data = ctx.accounts.new_committee_round.try_borrow_mut_data()?;
            // Zero everything first
            for b in data.iter_mut() {
                *b = 0;
            }
            // Anchor discriminator for CommitteeRound
            // discriminator = sha256("global:committee_round")[..8] (Anchor's convention)
            let disc_bytes = anchor_lang::solana_program::hash::hash(
                "global:committee_round".as_bytes()
            ).to_bytes();
            data[0..8].copy_from_slice(&disc_bytes[0..8]);
            // round at offset 8
            data[8..16].copy_from_slice(&new_round.to_le_bytes());
            // start_slot at offset 16
            data[16..24].copy_from_slice(&current_slot.to_le_bytes());
            // bump at last byte
            data[space as usize - 1] = new_cr_bump;
        }

        // Update protocol config
        config.current_round = new_round;
        config.current_round_start_slot = current_slot;
        config.total_rounds = config.total_rounds.checked_add(1)
            .ok_or(error!(RandomnessError::Overflow))?;

        Ok(())
    }

    pub fn register_validator(ctx: Context<RegisterValidator>, bond_amount: u64) -> Result<()> {
        require!(
            bond_amount >= ctx.accounts.protocol_config.min_bond,
            RandomnessError::BondBelowMinimum
        );

        let reg = &mut ctx.accounts.validator_reg;
        reg.validator = ctx.accounts.validator.key();
        reg.bond = bond_amount;
        reg.rounds_participated = 0;
        reg.rounds_missed = 0;
        reg.in_committee = false;
        reg.bump = ctx.bumps.validator_reg;

        anchor_lang::system_program::transfer(
            CpiContext::new(
                ctx.accounts.system_program.to_account_info(),
                anchor_lang::system_program::Transfer {
                    from: ctx.accounts.validator.to_account_info(),
                    to: ctx.accounts.validator_reg.to_account_info(),
                },
            ),
            bond_amount,
        )?;

        Ok(())
    }

    pub fn increase_bond(ctx: Context<IncreaseBond>, amount: u64) -> Result<()> {
        let reg = &mut ctx.accounts.validator_reg;
        reg.bond = reg.bond.checked_add(amount).ok_or(error!(RandomnessError::Overflow))?;

        anchor_lang::system_program::transfer(
            CpiContext::new(
                ctx.accounts.system_program.to_account_info(),
                anchor_lang::system_program::Transfer {
                    from: ctx.accounts.validator.to_account_info(),
                    to: ctx.accounts.validator_reg.to_account_info(),
                },
            ),
            amount,
        )?;

        Ok(())
    }

    pub fn withdraw_bond(ctx: Context<WithdrawBond>) -> Result<()> {
        let reg = &mut ctx.accounts.validator_reg;
        let bond_amount = reg.bond;
        reg.bond = 0;

        **reg.to_account_info().try_borrow_mut_lamports()? -= bond_amount;
        **ctx.accounts.validator.to_account_info().try_borrow_mut_lamports()? += bond_amount;

        Ok(())
    }

    pub fn slash_non_revealers(ctx: Context<SlashNonRevealers>) -> Result<()> {
        let round = &ctx.accounts.round;
        let slash_bps = SLASH_BPS as u64; // 10,000 = 100%

        // Find non-revealers: committed but didn't reveal
        let mut slashed_count = 0u32;
        let mut total_slashed = 0u64;

        for (i, committed) in round.committed.iter().enumerate() {
            if *committed && !round.revealed[i] && i < round.committee.len() {
                // Find matching ValidatorRegistration in remaining_accounts
                let validator_key = round.committee[i];
                if let Some(reg_info) = ctx.remaining_accounts.iter().find(|acc| *acc.key == validator_key) {
                    // Deserialize ValidatorRegistration
                    let data = reg_info.try_borrow_data()?;
                    // Check Anchor discriminator (first 8 bytes)
                    let disc: [u8; 8] = data[..8].try_into().map_err(|_| RandomnessError::CommitmentMismatch)?;
                    // Anchor discriminator = sha256("account:ValidatorRegistration")[..8]
                    let disc_hash = hash(b"account:ValidatorRegistration").to_bytes();
                    let expected_disc: [u8; 8] = disc_hash[..8].try_into().unwrap_or([0u8; 8]);
                    if disc != expected_disc {
                        continue;
                    }
                    // Read bond (offset 40 = 8 disc + 32 validator, u64 = 8 bytes)
                    let bond_bytes: [u8; 8] = data[40..48].try_into().map_err(|_| RandomnessError::Overflow)?;
                    let bond = u64::from_le_bytes(bond_bytes);
                    if bond == 0 {
                        continue; // Already slashed or no bond
                    }
                    let slash_amount = bond.checked_mul(slash_bps).ok_or(error!(RandomnessError::Overflow))? / 10_000;
                    if slash_amount == 0 {
                        continue;
                    }

                    // Transfer slashed lamports from validator registration to insurance fund
                    **reg_info.try_borrow_mut_lamports()? -= slash_amount;
                    **ctx.accounts.insurance_fund.try_borrow_mut_lamports()? += slash_amount;

                    // Zero out bond field in account data (offset 40, 8 bytes)
                    // This ensures the validator can't be slashed again and reflects true state
                    let mut data_mut = reg_info.try_borrow_mut_data()?;
                    data_mut[40..48].copy_from_slice(&0u64.to_le_bytes());

                    total_slashed = total_slashed.checked_add(slash_amount).ok_or(error!(RandomnessError::Overflow))?;
                    slashed_count += 1;
                }
            }
        }

        if slashed_count == 0 {
            return Err(error!(RandomnessError::NoNonRevealers));
        }

        Ok(())
    }

    pub fn distribute_fees(ctx: Context<DistributeFees>) -> Result<()> {
        let total_fees = ctx.accounts.fee_escrow.pending_fees;
        if total_fees == 0 {
            return Err(error!(RandomnessError::FeeEscrowInsufficient));
        }

        let reveal_count = ctx.accounts.round.reveal_count as u64;
        if reveal_count == 0 {
            return Err(error!(RandomnessError::FeeEscrowInsufficient));
        }

        let insurance_share = total_fees
            .checked_mul(FEE_INSURANCE_PCT as u64)
            .ok_or(error!(RandomnessError::Overflow))? / 100;

        **ctx.accounts.fee_escrow.to_account_info().try_borrow_mut_lamports()? -= insurance_share;
        **ctx.accounts.insurance_fund.try_borrow_mut_lamports()? += insurance_share;

        ctx.accounts.fee_escrow.pending_fees = total_fees
            .checked_sub(insurance_share)
            .ok_or(error!(RandomnessError::Overflow))?;

        Ok(())
    }

    // ── Agent Subscription Instructions ────────────────────────────────────

    /// Register an AI agent to receive automatic entropy callbacks.
    /// When a round aggregates, the protocol CPIs into callback_program
    /// with the fresh entropy. min_round_interval controls frequency.
    pub fn register_agent(
        ctx: Context<RegisterAgent>,
        callback_program: Pubkey,
        callback_instruction: [u8; 8],
        min_round_interval: u64,
        seed: [u8; 32],
    ) -> Result<()> {
        let sub = &mut ctx.accounts.agent_subscription;
        sub.callback_program = callback_program;
        sub.callback_instruction = callback_instruction;
        sub.min_round_interval = min_round_interval;
        sub.last_served_round = 0;
        sub.total_callbacks = 0;
        sub.authority = ctx.accounts.authority.key();
        sub.seed = seed;
        sub.bump = ctx.bumps.agent_subscription;

        Ok(())
    }

    /// Unregister an agent subscription. Only the authority can do this.
    pub fn unregister_agent(_ctx: Context<UnregisterAgent>) -> Result<()> {
        // Account is closed via `close = authority` in the struct
        Ok(())
    }

    /// Convenience: get a game seed from the current entropy pool.
    /// Returns SHA256(pool_entropy || game_id) instantly if pool is warm.
    /// If pool is cold, returns error — caller should queue a request instead.
    /// No account creation, no fee — just a read.
    pub fn game_seed(ctx: Context<GameSeed>, game_id: [u8; 32]) -> Result<[u8; 32]> {
        let pool = &ctx.accounts.entropy_pool;
        require!(pool.entropy_available, RandomnessError::EntropyPoolNotAvailable);

        let mut preimage = Vec::with_capacity(64);
        preimage.extend_from_slice(&pool.current_entropy);
        preimage.extend_from_slice(&game_id);
        let output = hash(&preimage).to_bytes();

        // Emit event so consumers can track which game_id maps to which seed
        emit!(GameSeedEvent {
            game_id,
            seed: output,
            pool_round: pool.current_round,
            pool_slot: pool.last_aggregated_slot,
        });

        Ok(output)
    }

    /// Verify an entropy receipt — trustless check that entropy was produced
    /// by the protocol at a specific round. Anyone can call this to audit.
    /// Creates an on-chain EntropyReceipt account that can be referenced by dApps.
    pub fn verify_entropy(ctx: Context<VerifyEntropy>, request_id: [u8; 32]) -> Result<()> {
        let round = &ctx.accounts.committee_round;
        require!(round.aggregated, RandomnessError::RoundNotAggregatable);

        let receipt = &mut ctx.accounts.entropy_receipt;
        receipt.round = round.round;
        receipt.entropy_output = round.entropy_output;
        receipt.reveal_count = round.reveal_count;
        receipt.committee_size = round.committee.len() as u32;
        receipt.aggregated_slot = round.aggregated_slot;
        receipt.ee_v4_included = round.entropy_set; // entropy_set means EE was mixed
        receipt.request_id = request_id;
        receipt.derived_output = hash(
            &[&round.entropy_output[..], &request_id[..]].concat()
        ).to_bytes();
        receipt.bump = ctx.bumps.entropy_receipt;

        emit!(EntropyVerifiedEvent {
            round: round.round,
            entropy_output: round.entropy_output,
            derived_output: receipt.derived_output,
            reveal_count: round.reveal_count,
            committee_size: receipt.committee_size,
        });

        Ok(())
    }

    pub fn close_request(_ctx: Context<CloseRequest>) -> Result<()> {
        Ok(())
    }
}

// ── Agent Subscription Accounts ──────────────────────────────────────────────

#[derive(Accounts)]
#[instruction(callback_program: Pubkey, callback_instruction: [u8; 8], min_round_interval: u64, seed: [u8; 32])]
pub struct RegisterAgent<'info> {
    #[account(
        init,
        payer = authority,
        space = AgentSubscription::INIT_SPACE,
        seeds = [b"agent-sub", authority.key().as_ref(), seed.as_ref()],
        bump,
    )]
    pub agent_subscription: Account<'info, AgentSubscription>,
    #[account(mut)]
    pub authority: Signer<'info>,
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct UnregisterAgent<'info> {
    #[account(
        mut,
        close = authority,
        seeds = [b"agent-sub", agent_subscription.authority.as_ref(), agent_subscription.seed.as_ref()],
        bump = agent_subscription.bump,
        constraint = agent_subscription.authority == authority.key() @ RandomnessError::Unauthorized,
    )]
    pub agent_subscription: Account<'info, AgentSubscription>,
    #[account(mut)]
    pub authority: Signer<'info>,
}

#[derive(Accounts)]
pub struct GameSeed<'info> {
    #[account(
        seeds = [b"entropy-pool"],
        bump = entropy_pool.bump,
    )]
    pub entropy_pool: Account<'info, EntropyPool>,
}

#[derive(Accounts)]
#[instruction(request_id: [u8; 32])]
pub struct VerifyEntropy<'info> {
    #[account(
        init,
        payer = caller,
        space = EntropyReceipt::INIT_SPACE,
        seeds = [b"receipt", request_id.as_ref()],
        bump,
    )]
    pub entropy_receipt: Account<'info, EntropyReceipt>,
    #[account(
        seeds = [b"committee-round", &committee_round.round.to_le_bytes()],
        bump = committee_round.bump,
        constraint = committee_round.aggregated @ RandomnessError::RoundNotAggregatable,
    )]
    pub committee_round: Account<'info, CommitteeRound>,
    #[account(mut)]
    pub caller: Signer<'info>,
    pub system_program: Program<'info, System>,
}

// ── Events ──────────────────────────────────────────────────────────────────

#[event]
pub struct GameSeedEvent {
    pub game_id: [u8; 32],
    pub seed: [u8; 32],
    pub pool_round: u64,
    pub pool_slot: u64,
}

#[event]
pub struct EntropyVerifiedEvent {
    pub round: u64,
    pub entropy_output: [u8; 32],
    pub derived_output: [u8; 32],
    pub reveal_count: u32,
    pub committee_size: u32,
}

#[event]
pub struct CallbackDeliveredEvent {
    pub callback_program: Pubkey,
    pub derived_output: [u8; 32],
    pub round: u64,
    pub total_callbacks: u64,
}

#[derive(Accounts)]
pub struct DeliverCallback<'info> {
    #[account(
        mut,
        seeds = [b"agent-sub", agent_subscription.authority.as_ref(), agent_subscription.seed.as_ref()],
        bump = agent_subscription.bump,
    )]
    pub agent_subscription: Account<'info, AgentSubscription>,
    #[account(
        seeds = [b"entropy-pool"],
        bump = entropy_pool.bump,
        constraint = entropy_pool.entropy_available @ RandomnessError::EntropyPoolNotAvailable,
    )]
    pub entropy_pool: Account<'info, EntropyPool>,
    #[account(
        seeds = [b"protocol-config"],
        bump = protocol_config.bump,
    )]
    pub protocol_config: Account<'info, ProtocolConfig>,
}